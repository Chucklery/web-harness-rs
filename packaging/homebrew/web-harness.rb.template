class WebHarness < Formula
  desc "Lightweight local Codex-style execution host for ChatGPT Web"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/web-harness-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@MAC_ARM_SHA256@"
    else
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/web-harness-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@MAC_X64_SHA256@"
    end
  end

  on_linux do
    url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/web-harness-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "@LINUX_X64_SHA256@"
  end

  def install
    bin.install "web-harness"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/web-harness version")
  end
end
